{
  "name": "employee-management-system",
  "version": "1.0.0",
  "description": "HR Tech & Safety Management System",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "check": "node --check server.js && node --check database.js && node --check scripts/migrate-sqlite-to-postgres.js && node --check security.js && node --check public/security.js && node --check scripts/migrate-photos-to-storage.js",
    "migrate:postgres": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-postgres.js",
    "migrate:photos": "node --env-file-if-exists=.env scripts/migrate-photos-to-storage.js",
    "test:security": "node tests/security.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "2.4.0",
    "pg": "^8.13.1",
    "sqlite3": "6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "body-parser": {
      "qs": "6.16.0"
    }
  }
}
