# 실제 값은 충분히 긴 무작위 문자열로 설정하고 .env 파일은 외부에 공유하지 않습니다.
# Render(백엔드)의 Environment에 아래 값들을 등록합니다.

# --- 필수 ---
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
NODE_ENV=production

# --- Supabase Postgres (Project Settings > Database > Connection string > URI) ---
# 비밀번호 부분을 실제 DB 비밀번호로 치환. Render는 IPv4가 필요하므로 6543 pooler 권장.
DATABASE_URL=postgresql://postgres.fhoawmdsvnunilolvrxv:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# --- Supabase Storage (새 사진 업로드 영구 저장) ---
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SERVICE_KEY: Project Settings > API > service_role key (절대 프론트에 노출 금지)
SUPABASE_URL=https://fhoawmdsvnunilolvrxv.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_BUCKET=photos

# --- CORS: Netlify 프론트 주소 (프록시만 쓰면 없어도 됨) ---
# CORS_ORIGIN=https://your-site.netlify.app
